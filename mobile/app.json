{
  "expo": {
    "name": "HAL",
    "slug": "hal",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "in.hal.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B5E20"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.hal.app"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F3"
        }
      ],
      "react-native-fast-tflite",
      [
        "expo-build-properties",
        {
          "_comment": "Android 9+ blocks plain HTTP by default. Render serves HTTPS so the normal path is unaffected, but the demo fallback is running uvicorn on the presenting laptop over the LAN, which is http:// and would be blocked silently, with no error the farmer or the presenter could see. Remove this before any store build.",
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "पत्ते की फ़ोटो लेकर बीमारी पहचानने के लिए कैमरा चाहिए"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "खेत की जगह दर्ज करने के लिए लोकेशन चाहिए"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
